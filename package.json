{
  "name": "supermarkets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "node scripts/format.mjs",
    "no-comments": "tsx scripts/no-comments.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format --check && pnpm no-comments && pnpm docs:check && pnpm test && pnpm product-types && pnpm payment-cards && pnpm order:eval-set",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "carrefour:catalog": "tsx src/cli/carrefour-catalog.ts",
    "test": "vitest run",
    "product-types": "tsx src/cli/product-types.ts",
    "payment-cards": "tsx src/cli/payment-cards.ts",
    "seed:split": "tsx src/cli/seed-split.ts",
    "seed:check-proposal": "tsx src/cli/seed-check-proposal.ts",
    "seed:consolidate": "tsx src/cli/seed-consolidate.ts",
    "seed:coverage": "tsx src/cli/seed-coverage.ts",
    "seed:doubts": "tsx src/cli/seed-doubts.ts",
    "order:eval": "tsx src/cli/order-eval.ts",
    "order:eval-set": "tsx src/cli/order-eval-set.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
