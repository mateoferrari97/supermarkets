{
  "name": "supermarkets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "node scripts/format.mjs",
    "no-comments": "tsx scripts/no-comments.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format --check && pnpm no-comments && pnpm test && pnpm product-types",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "carrefour:catalog": "tsx scripts/carrefour-catalog.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "product-types": "tsx scripts/validate-product-types.ts",
    "seed:split": "tsx scripts/seed-split.ts",
    "seed:check-proposal": "tsx scripts/seed-check-proposal.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2",
    "typescript7": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
