{
  "name": "supermarkets",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "node scripts/format.mjs",
    "no-comments": "tsx scripts/no-comments.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format --check && pnpm no-comments && pnpm docs:check && pnpm test && pnpm agent:eval-set",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "carrefour:catalog": "tsx src/cli/carrefour-catalog.ts",
    "test": "vitest run",
    "agent:eval": "tsx src/cli/agent-eval.ts",
    "agent:eval-set": "tsx src/cli/agent-eval-set.ts",
    "agent:label": "tsx src/cli/agent-label.ts",
    "chat:turns": "tsx src/cli/chat-turns.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.2",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "ai": "7.0.143",
    "ai-sdk-provider-claude-code": "4.3.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  }
}
